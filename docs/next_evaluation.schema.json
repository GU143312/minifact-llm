{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiniFact prospective news dataset",
  "type": "object",
  "required": ["schema_version", "status", "source", "license", "samples", "semantic_ids", "history_sha256", "excluded_source_indices", "gold_scope"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "candidate_pending_event_review_and_human_annotation"},
    "source": {"type": "object"},
    "license": {"type": "object"},
    "gold_scope": {"type": "string"},
    "history_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "excluded_source_indices": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "semantic_ids": {"type": "array", "minItems": 60, "maxItems": 60, "uniqueItems": true, "items": {"type": "string", "pattern": "^MFN-[0-9]{4}$"}},
    "samples": {
      "type": "array", "minItems": 200, "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "text", "context", "gold", "provenance", "upstream_record"],
        "properties": {
          "id": {"type": "string", "pattern": "^MFN-[0-9]{4}$"},
          "text": {"type": "string", "minLength": 1},
          "context": {"type": "object"},
          "gold": {
            "type": "object",
            "required": ["verdict", "original_label", "verdict_scope", "questions", "justification"],
            "properties": {"verdict": {"enum": ["SUPPORTED", "REFUTED"]}, "verdict_scope": {"const": "whole_sample"}}
          },
          "provenance": {
            "type": "object", "additionalProperties": false,
            "required": ["original_split", "source_record_index", "source_record_sha256"],
            "properties": {
              "original_split": {"const": "train"},
              "source_record_index": {"type": "integer", "minimum": 0},
              "source_record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          },
          "upstream_record": {"type": "object"}
        }
      }
    }
  }
}
